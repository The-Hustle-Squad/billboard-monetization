PORT=3000
API_PREFIX=api/v1

# Comma-separated browser origins allowed for CORS (e.g. http://localhost:3002,https://app.example.com).
# If unset, any origin is allowed (reflect). Set explicitly in production.
CORS_ORIGINS=

MONGO_URI=mongodb://localhost:27017/vacantslot

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
# Set true only if your Redis endpoint requires TLS (rediss:// / "SSL" in dashboard)
REDIS_TLS=false
